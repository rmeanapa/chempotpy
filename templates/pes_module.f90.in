! System:                        {{SYSTEM}}
! Functional form:               {{FUNCTIONAL_FORM}}
! Common name:                   {{COMMON_NAME}}
! Reference:                     {{REFERENCE}}
! Number of derivatives:         {{DERIVATIVES}}
! Number of bodies:              {{BODIES}}
! Number of electronic surfaces: {{NSTATES}}
! Interface:                     PES
! Data file:                     none; immutable parameters are embedded
! Notes:                         Replace the scaffold evaluator with the published model.
! CHEMPOTPY_IMPLEMENTATION_REQUIRED: implement and independently validate this surface.

!> @brief Implement {{SURFACE}}, a potential energy surface for {{SYSTEM}}.
module {{MODULE_NAME}}_pes
    use chempotpy_kinds, only: wp
    implicit none
    private
    public :: evaluate

    contains

    !> @brief Evaluate the {{SURFACE}} potential energy surface for {{SYSTEM}}.
    subroutine evaluate( x, igrad, p, g, d, status )
        use chempotpy_status, only: chempotpy_status_t, status_model_unavailable
        use chempotpy_kinds,  only: wp
        implicit none
        type(chempotpy_status_t), intent(out), optional :: status
        integer, parameter    :: natoms  = {{NATOMS}}
        integer, parameter    :: nstates = {{NSTATES}}
        integer, intent(in)   :: igrad
        real(wp), intent(in)  :: x(natoms,3)
        real(wp), intent(out) :: p(nstates), g(nstates,natoms,3)
        real(wp), intent(out) :: d(nstates,nstates,natoms,3)
        p = 0.e0_wp; g = 0.e0_wp; d = 0.e0_wp
        if( present(status) ) call status%set(status_model_unavailable, &
            'the generated PES scaffold has not been implemented')
    end subroutine evaluate
end module {{MODULE_NAME}}_pes

!> @brief Expose {{SURFACE}} through the Python-facing PES entry point.
subroutine pes( x, igrad, p, g, d )
    use {{MODULE_NAME}}_pes, only: evaluate
    use chempotpy_kinds,               only: wp
    implicit none
    integer, parameter    :: natoms  = {{NATOMS}}
    integer, parameter    :: nstates = {{NSTATES}}
    integer, intent(in)   :: igrad
    real(wp), intent(in)  :: x(natoms,3)
    real(wp), intent(out) :: p(nstates)
    real(wp), intent(out) :: g(nstates,natoms,3)
    real(wp), intent(out) :: d(nstates,nstates,natoms,3)
    call evaluate(x, igrad, p, g, d)
end subroutine pes

!> @brief Define the supported H3Cl PIP-NN Python extension interface.
python module H3Cl_PIPNN
    interface
        !> @brief Evaluate the H3Cl PIP-NN single-state energy.
        subroutine pes( x, igrad, path, p, g, d )
            integer, parameter :: nstates = 1
            integer, parameter :: natoms = 4
            real(8), intent(in) :: x(natoms,3)
            integer, intent(in) :: igrad
            character(len=1024), intent(in) :: path
            real(8), intent(out) :: p(nstates)
            real(8), intent(out) :: g(nstates,natoms,3)
            real(8), intent(out) :: d(nstates,nstates,natoms,3)
        end subroutine pes
    end interface
end python module H3Cl_PIPNN
